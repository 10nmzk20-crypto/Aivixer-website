{
  "name": "vixer-ai-company",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && wrangler dev",
    "dev:web": "vite",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply vixer-ai-company-db --local",
    "db:migrate": "wrangler d1 migrations apply vixer-ai-company-db --remote",
    "cf-typegen": "wrangler types",
    "ai:check": "tsx scripts/ai-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  }
}
