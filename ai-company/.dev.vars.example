# ローカル開発用。コピーして .dev.vars にする（.dev.vars は Git に入れない）
ENVIRONMENT=development
# none: 外部 AI を呼ばない（今の運用。ChatGPT 用レポートを作って分析する）
AI_PROVIDER=none
# 本物の Claude を使う場合
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# 共有パスワード方式で保護する場合（Cloudflare Access を使わないとき）
# APP_PASSWORD=change-me
# APP_SESSION_SECRET=long-random-string
