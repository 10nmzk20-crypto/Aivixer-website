# ローカル開発用。コピーして .dev.vars にする（.dev.vars は Git に入れない）
ENVIRONMENT=development
# AI_PROVIDER を mock にすると API キーなしで動作確認できる（固定のサンプル回答を返す）
AI_PROVIDER=mock
# 本物の Claude を使う場合
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# 共有パスワード方式で保護する場合（Cloudflare Access を使わないとき）
# APP_PASSWORD=change-me
# APP_SESSION_SECRET=long-random-string
